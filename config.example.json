{
  "listen": "127.0.0.1:8080",
  "server_keys": ["change-this-local-key"],
  "keys": ["sk-your-zen-key"],
  "anonymous": false,
  "proxy_pools": {
    "shared": {
      "proxies": ["direct"],
      "proxyfile": ""
    }
  },
  "proxy_routing": {
    "anonymous": "shared",
    "authenticated": "shared"
  },
  // fallback channels: protocol "chat" (Chat Completions, default) or "responses" (Responses).
  // reasoning_effort "" (supplier default), "low", "medium" or "high" per channel.
  // base supports host, host/v1, or the matching full endpoint; e.g.
  // {"name":"c1","base_url":"https://...","api_key":"...","model":"...","protocol":"chat","reasoning_effort":""}.
  "fallback": {
    "active": "",
    "channels": []
  },
  "upstream": {
    "zen": "https://opencode.ai/zen"
  },
  "retry": {
    "max_attempts": 3,
    "timeout_seconds": 300
  },
  "models": {
    "refresh_seconds": 300,
    "protocols": {}
  },
  "performance": {
    "max_idle_conns": 2048,
    "max_idle_conns_per_host": 256,
    "max_conns_per_host": 0,
    "idle_conn_timeout_seconds": 120,
    "connect_timeout_seconds": 5,
    "failure_cooldown_seconds": 15,
    "rate_limit_cooldown_seconds": 300
  },
  "logging": {
    "level": "info",
    "ring_size": 2000
  },
  "history": {
    "enabled": true,
    "directory": "",
    "retention_days": 7,
    "max_bytes_mb": 128
  },
  "webui": {
    "enabled": true,
    "listen": "0.0.0.0:8081",
    "username": "admin",
    "password": "change-this-admin-password",
    "session_ttl_minutes": 720
  }
}
